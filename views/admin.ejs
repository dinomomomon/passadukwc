<%- include('header') %><h1>ตั้งค่าระบบ</h1><div class="admin-grid"><section class="card"><h2>โรงเรียนและผู้ลงนาม</h2><p class="muted">ใช้กับรายการใหม่ รายการเก่าจะเก็บชื่อเดิม</p><form method="post" action="/admin/settings"><input type="hidden" name="_csrf" value="<%= csrf %>"><% for(const [key,label] of [['school','ชื่อโรงเรียน'],['officer','เจ้าหน้าที่พัสดุผู้ลงนาม'],['head','หัวหน้าเจ้าหน้าที่พัสดุ'],['director','ผู้อำนวยการ']]){ %><label><%= label %><input name="<%= key %>" value="<%= settings[key] %>" required></label><% } %><button>บันทึกการตั้งค่า</button></form></section><section class="card"><h2>เพิ่มผู้ใช้งาน</h2><form method="post" action="/admin/users"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>ชื่อ–นามสกุล<input name="name" required></label><label>ชื่อผู้ใช้ (อังกฤษ)<input name="username" pattern="[a-zA-Z0-9._-]{3,50}" required></label><label>รหัสผ่านเริ่มต้น (อย่างน้อย 12 ตัว)<input name="password" type="password" minlength="12" required autocomplete="new-password"></label><label>สิทธิ์<select name="role"><option value="staff">เจ้าหน้าที่พัสดุ</option><option value="admin">ผู้ดูแลระบบ</option></select></label><button>เพิ่มผู้ใช้</button></form></section></div><section class="card"><h2>บัญชีผู้ใช้</h2><div class="tablewrap"><table><thead><tr><th>ชื่อ</th><th>ชื่อผู้ใช้</th><th>สิทธิ์</th><th>สถานะ</th><th></th></tr></thead><tbody><% for(const u of users){ %><tr><td><%= u.name %></td><td><%= u.username %></td><td><%= u.role==='admin'?'ผู้ดูแล':'เจ้าหน้าที่' %></td><td><%= u.active?'เปิดใช้งาน':'ปิดใช้งาน' %></td><td><% if(u.id!==user.id){ %><form method="post" action="/admin/users/<%= u.id %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="quiet"><%= u.active?'ปิดบัญชี':'เปิดบัญชี' %></button></form><% } %></td></tr><% } %></tbody></table></div></section><section class="card"><h2>ประวัติการเปลี่ยนแปลงล่าสุด</h2><table><thead><tr><th>เวลา (UTC)</th><th>ผู้ทำรายการ</th><th>การดำเนินการ</th><th>รายการ</th></tr></thead><tbody><% for(const l of logs){ %><tr><td><%= l.createdAt %></td><td><%= l.name||'ระบบ' %></td><td><%= l.action %></td><td><% if(l.recordId){ %><a href="/records/<%= l.recordId %>">#<%= l.recordId %></a><% } %></td></tr><% } %></tbody></table></section><%- include('footer') %>