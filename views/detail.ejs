<%- include('header') %><div class="pagehead"><div><span class="eyebrow"><%= kindName(record.kind) %> · <%= record.number %>/<%= record.year %></span><h1><%= record.title %></h1><p class="muted"><%= dateTH(record.date) %></p></div><div class="actions"><a class="button quiet" href="/records/<%= record.id %>/edit">แก้ไขข้อมูล / เลขที่</a><a class="button" href="/records/<%= record.id %>/print">ชุดเอกสารสำหรับพิมพ์</a></div></div><section class="card"><h2>รายละเอียด</h2><p class="pre"><%= record.reason %></p><dl><dt>ผู้ขาย / ผู้รับจ้าง</dt><dd><%= record.vendor %></dd><dt>แหล่งเงิน</dt><dd><%= record.budget %></dd><dt>วิธีดำเนินการ</dt><dd><%= record.method %></dd></dl><table><thead><tr><th>รายการ</th><th>จำนวน</th><th>ราคา / หน่วย</th><th>รวม</th></tr></thead><tbody><% for(const i of items){ %><tr><td><%= i.name %></td><td><%= i.qty %> <%= i.unit %></td><td><%= money(i.price) %></td><td><%= money(i.qty*i.price) %></td></tr><% } %></tbody></table><p class="total"><%= money(record.total) %> บาท</p><p class="muted">ผู้ลงนามที่บันทึกไว้: <%= record.officer %> / <%= record.head %> / <%= record.director %></p></section><%- include('footer') %>