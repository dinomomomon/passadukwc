<%- include('header') %><div class="pagehead"><div><span class="eyebrow">งานพัสดุ / ภาพรวม</span><h1>รายการจัดซื้อจัดจ้าง</h1><p class="muted">ข้อมูลส่วนกลาง · เลขเอกสารแยกประเภทและปีงบประมาณ</p></div><a class="button" href="/records/new">+ สร้างรายการใหม่</a></div><div class="stats"><% for(const k of ['purchase','hire']){const s=stats.find(s=>s.kind===k); %><section class="card"><span class="badge"><%= kindName(k) %></span><h2><%= s?.count||0 %> <small>รายการ</small></h2><p class="muted">รวม <%= money(s?.total||0) %> บาท</p></section><% } %><section class="card"><span class="eyebrow">ขอบเขตระบบ</span><h2>5,000 <small>บาท / รายการ</small></h2><p class="muted">ยอดรวมสุทธิ รวมภาษีและค่าใช้จ่าย</p></section></div><div class="notice">แบบเอกสารยังเป็นฉบับร่าง ต้องตรวจรับรูปแบบและเงื่อนไขตามระเบียบก่อนใช้จริง การพิจารณา e-GP ต้องตรวจเงื่อนไขที่เกี่ยวข้องเพิ่มเติม</div><section class="card"><form class="filters" method="get"><input aria-label="ค้นหา" name="q" value="<%= q %>" placeholder="ค้นหาชื่องาน ผู้ขาย หรือเลขที่"><select name="kind" aria-label="ประเภท"><option value="">ทุกประเภท</option><option value="purchase" <%= kind==='purchase'?'selected':'' %>>จัดซื้อ</option><option value="hire" <%= kind==='hire'?'selected':'' %>>จัดจ้าง</option></select><button>ค้นหา</button></form><div class="tablewrap"><table><thead><tr><th>เลขที่ / ปี</th><th>ประเภท</th><th>รายการ</th><th>ผู้ขาย / ผู้รับจ้าง</th><th>ยอดสุทธิ (บาท)</th><th></th></tr></thead><tbody><% for(const row of rows){ %><tr><td><%= row.number %>/<%= row.year %></td><td><span class="badge"><%= kindName(row.kind) %></span></td><td><strong><%= row.title %></strong><small><%= dateTH(row.date) %></small></td><td><%= row.vendor %></td><td><%= money(row.total) %></td><td><a href="/records/<%= row.id %>">เปิดรายการ →</a></td></tr><% } %><% if(!rows.length){ %><tr><td colspan="6" class="empty">ยังไม่มีรายการที่ตรงกับการค้นหา เริ่มต้นด้วยการสร้างรายการใหม่</td></tr><% } %></tbody></table></div><p class="muted">แสดงรายการล่าสุดสูงสุด 200 รายการ</p></section><%- include('footer') %>