# Never commit real secret values. Node does not automatically read this file.
# For local use: node --env-file=.env app.js
HOST=127.0.0.1
PORT=3000
DB_PATH=./data/school.db
# Set SESSION_SECRET to a random secret of at least 32 characters.
# SESSION_SECRET=
# Set a separate SETUP_TOKEN before creating the first administrator.
# SETUP_TOKEN=
# Production requires HTTPS reverse proxy and secure cookies.
# NODE_ENV=production
# TRUST_PROXY=1

# Vercel/Supabase: configure securely in Vercel Settings (never commit values).
# DATABASE_URL=
